[Unit]
Description=OKLL Trader Dashboard (HTTP)
After=network.target

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__REPO_DIR__
EnvironmentFile=__REPO_DIR__/.env
ExecStart=__VENV_DIR__/bin/python dashboard.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=okll-dashboard

[Install]
WantedBy=multi-user.target
